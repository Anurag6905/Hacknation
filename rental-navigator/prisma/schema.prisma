// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // Use PostgreSQL for production
  url      = env("DATABASE_URL")
}

model Property {
  id             String         @id @default(uuid())
  addressLine1   String
  city           String
  state          String
  zip            String
  latitude       Float?
  longitude      Float?
  jurisdictions  Jurisdiction[] @relation("PropertyJurisdictions")
  questionsAsked Question[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Jurisdiction {
  id             String          @id @default(uuid())
  name           String
  level          String          // "State", "County", "City", "Local"
  properties     Property[]      @relation("PropertyJurisdictions")
  documents      LegalDocument[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model LegalTopic {
  id          String          @id @default(uuid())
  name        String          @unique // rent_increase, rent_control, etc.
  description String?
  documents   LegalDocument[] @relation("DocumentTopics")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model LegalDocument {
  id               String           @id @default(uuid())
  title            String
  jurisdictionId   String
  jurisdiction     Jurisdiction     @relation(fields: [jurisdictionId], references: [id])
  jurisdictionLevel String          // Mirroring requirements
  topics           LegalTopic[]     @relation("DocumentTopics")
  text             String
  source_url       String
  authority_level  String           // "PRIMARY", "OFFICIAL_GUIDANCE", "SECONDARY"
  effective_from   DateTime
  effective_until  DateTime?
  status           String           // "CURRENT", "FUTURE", "PENDING", "REPEALED"
  provisions       LegalProvision[]
  citations        Citation[]
  last_updated     DateTime         @updatedAt
  createdAt        DateTime         @default(now())
}

model LegalProvision {
  id              String        @id @default(uuid())
  documentId      String
  document        LegalDocument @relation(fields: [documentId], references: [id])
  section         String?       
  text            String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Question {
  id           String    @id @default(uuid())
  propertyId   String
  property     Property  @relation(fields: [propertyId], references: [id])
  questionText String
  answers      Answer[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Answer {
  id           String     @id @default(uuid())
  questionId   String
  question     Question   @relation(fields: [questionId], references: [id])
  shortAnswer  String
  explanation  String
  confidence   String     // "High", "Medium", "Low"
  targetDate   DateTime?  // The date context for the answer
  citations    Citation[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Citation {
  id              String        @id @default(uuid())
  answerId        String
  answer          Answer        @relation(fields: [answerId], references: [id])
  documentId      String
  document        LegalDocument @relation(fields: [documentId], references: [id])
  claim           String
  relevant_text   String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}
